{
  "name": "object-ontology",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "preview": true,
  "publisher": "ObjectPL",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/theObjectCo/object-ontology.git"
  },
  "bugs": "https://github.com/theObjectCo/object-ontology/issues",
  "homepage": "https://github.com/theObjectCo/object-ontology#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Linters"
  ],
  "keywords": [
    "opm",
    "object-process methodology",
    "iso 19450",
    "ontology",
    "model",
    "diagram",
    "json schema",
    "opl"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "opm": "./dist/cli.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.opm.json"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "*.opm.json",
        "url": "./schema/opm-model.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "opm.diagram",
        "displayName": "%editor.diagram%",
        "selector": [
          {
            "filenamePattern": "*.opm.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opm",
          "title": "%container.opm%",
          "icon": "resources/opm.svg"
        }
      ]
    },
    "views": {
      "opm": [
        {
          "id": "opm.models",
          "name": "%view.models%"
        },
        {
          "id": "opm.model",
          "name": "%view.model%"
        },
        {
          "id": "opm.views",
          "name": "%view.views%"
        }
      ]
    },
    "commands": [
      {
        "command": "opm.newModel",
        "title": "%command.newModel%",
        "category": "OPM",
        "icon": "$(new-file)"
      },
      {
        "command": "opm.openTextBeside",
        "title": "%command.openTextBeside%",
        "category": "OPM",
        "icon": "$(go-to-file)"
      },
      {
        "command": "opm.openDiagramBeside",
        "title": "%command.openDiagramBeside%",
        "category": "OPM",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "opm.findElement",
        "title": "%command.findElement%",
        "category": "OPM",
        "icon": "$(search)"
      },
      {
        "command": "opm.saveSelectionAsView",
        "title": "%command.saveSelectionAsView%",
        "category": "OPM",
        "icon": "$(save-as)"
      },
      {
        "command": "opm.removeStaleLayout",
        "title": "%command.removeStaleLayout%",
        "category": "OPM"
      },
      {
        "command": "opm.exportMarkdown",
        "title": "%command.exportMarkdown%",
        "category": "OPM"
      },
      {
        "command": "opm.createSchema",
        "title": "%command.createSchema%",
        "category": "OPM"
      },
      {
        "command": "opm.revealElement",
        "title": "%command.revealElement%",
        "category": "OPM"
      },
      {
        "command": "opm.openView",
        "title": "%command.openView%",
        "category": "OPM"
      },
      {
        "command": "opm.openModel",
        "title": "%command.openModel%",
        "category": "OPM"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opm.openTextBeside",
          "when": "activeCustomEditorId == opm.diagram",
          "group": "navigation"
        },
        {
          "command": "opm.openDiagramBeside",
          "when": "resourceFilename =~ /\\.opm\\.json$/ && !activeCustomEditorId",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "opm.newModel",
          "when": "view == opm.models",
          "group": "navigation"
        },
        {
          "command": "opm.findElement",
          "when": "view == opm.model",
          "group": "navigation"
        },
        {
          "command": "opm.saveSelectionAsView",
          "when": "view == opm.views",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "opm.newModel",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "opm.openDiagramBeside",
          "when": "resourceFilename =~ /\\.opm\\.json$/"
        },
        {
          "command": "opm.exportMarkdown",
          "when": "resourceFilename =~ /\\.opm\\.json$/"
        },
        {
          "command": "opm.createSchema",
          "when": "resourceFilename =~ /\\.opm\\.json$/"
        }
      ],
      "commandPalette": [
        {
          "command": "opm.revealElement",
          "when": "false"
        },
        {
          "command": "opm.openView",
          "when": "false"
        },
        {
          "command": "opm.openDiagramBeside",
          "when": "resourceFilename =~ /\\.opm\\.json$/"
        },
        {
          "command": "opm.openTextBeside",
          "when": "activeCustomEditorId == opm.diagram"
        },
        {
          "command": "opm.openModel",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "OPM",
      "properties": {
        "opm.schemaGlob": {
          "type": "string",
          "default": "**/*.schema.json",
          "markdownDescription": "%config.schemaGlob%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "opm.models",
        "contents": "%welcome.models%"
      },
      {
        "view": "opm.model",
        "contents": "%welcome.model%"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc && tsc -p tsconfig.webview.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "package": "npm run build && vsce package --no-dependencies -o dist/object-ontology.vsix",
    "shots": "node build.mjs --harness && node test/harness/shots.mjs examples/window-pricing/model.opm.json dist/shots"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "l10n": "./l10n"
}
